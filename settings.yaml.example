channels:
  - telegram: "@Khabar_Fouri"
    wemessenger_node: "PASTE_FIRST_CHANNEL_UUID"
    poll_interval_seconds: 30
    publish_interval_seconds: 15
    send_delay_seconds: 20
    retention_days: 30

  - telegram: "@khabaronline_ir"
    wemessenger_node: "PASTE_SECOND_CHANNEL_UUID"
    poll_interval_seconds: 60
    publish_interval_seconds: 30
    send_delay_seconds: 30
    retention_days: 90

limit: 50
download_photos: true
database: data/telegram.db

poll: true
poll_interval: 10
publish_interval: 15
send_delay_seconds: 20
retention_days: 0 # 0 disables automatic deletion

log_file: logs/scrape.log
log_level: INFO

# Independent proxy toggles for each outbound path
scraper_use_proxy: true
publish_use_proxy: false

# Proxy URL used by either scraper or publish when its respective flag is enabled
telegram_proxy: "socks5://127.0.0.1:10808"

wemessenger:
  enabled: true
  bot_token: "PASTE_BOT_TOKEN"
  api_base: "https://api.wemessenger.ir"
  file_upload_url: "https://ms-file.wemessenger.ir/upload"
  to_category: "CHANNEL"
  session_id: "*"
